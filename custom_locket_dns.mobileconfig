<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadDisplayName</key>
	<string>Custom Locket Gold DNS</string>
	<key>PayloadDescription</key>
	<string>Định tuyến các domain Locket qua NextDNS DoH (profile 9bdf38). Profile này không cài chứng chỉ Root CA.</string>
	<key>PayloadIdentifier</key>
	<string>com.custom.locketgold.dns.profile</string>
	<key>PayloadOrganization</key>
	<string>NextDNS</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>E84B1F22-5401-4DC3-8106-25805561AA12</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadContent</key>
	<array>
		<!-- 1. Cấu hình DNS-over-HTTPS (DoH) với Match Domains -->
		<dict>
			<key>PayloadType</key>
			<string>com.apple.dnsSettings.managed</string>
			<key>PayloadIdentifier</key>
			<string>com.custom.locketgold.dns.settings</string>
			<key>PayloadUUID</key>
			<string>A59D3F87-8A7B-4F7D-9D21-1250395D11BC</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadDisplayName</key>
			<string>Locket DNS via NextDNS</string>
			<key>PayloadDescription</key>
			<string>Định tuyến các tên miền Locket / RevenueCat qua NextDNS DoH</string>
			<key>DNSSettings</key>
			<dict>
				<key>DNSProtocol</key>
				<string>HTTPS</string>
				<key>ServerURL</key>
				<string>https://dns.nextdns.io/9bdf38</string>
				<!-- Danh sách domain được chỉ định phân giải qua DNS riêng này -->
				<key>SupplementalMatchDomains</key>
				<array>
					<string>api.revenuecat.com</string>
					<string>revenuecat.com</string>
					<string>analytics.revenuecat.com</string>
					<string>rc-cdn.revenuecat.com</string>
					<string>sdk.revenuecat.com</string>
					<string>gateway.revenuecat.com</string>
					<string>errors.revenuecat.com</string>
					<string>identity.revenuecat.com</string>
					<string>customer.revenuecat.com</string>
					<string>subscriptions.revenuecat.com</string>
					<string>firebaseremoteconfig.googleapis.com</string>
					<string>firebaseremoteconfigrealtime.googleapis.com</string>
					<string>us-central1-locket-4252a.cloudfunctions.net</string>
					<string>api.locketcamera.com</string>
					<string>locketcamera.com</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
